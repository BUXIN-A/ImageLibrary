# 复制为 .env 后按需修改（Docker Compose 会自动读取同目录下的 .env）
# 注意：.env 已被 .gitignore 忽略，请勿提交到仓库。

# ---------- 端口（同时决定容器内监听端口与宿主机映射端口） ----------
API_PORT=8080
FRONTEND_PORT=8000
ADMIN_PORT=8001

# ---------- 管理员账号 ----------
# 默认仅在数据库首次初始化时写入；ADMIN_FORCE_SYNC=true 时每次启动都强制覆盖
ADMIN_USERNAME=admin
# 留空或使用弱口令时，首次建库会自动生成随机密码并打印到启动日志（仅显示一次）
ADMIN_PASSWORD=
ADMIN_FORCE_SYNC=false

# ---------- JWT 签名密钥 ----------
# 留空会自动生成随机密钥并持久化到 data/.secret_key；生产环境建议显式设置为 >=32 字节随机串
SECRET_KEY=

# ---------- 对外访问主机（填服务器 IP 或域名） ----------
# 影响分享链接、OAuth 回调地址与 CORS；留空则按访问者主机名自动推断 API 地址
PUBLIC_HOST=
PUBLIC_SCHEME=http
# 额外允许的跨域来源（逗号分隔），一般无需设置
CORS_ORIGINS=

# ---------- 可选 ----------
# 图片单文件上传上限（字节，默认 20MB）
MAX_UPLOAD_SIZE=20971520
# 视频单文件上传上限（字节，默认 200MB）
MAX_VIDEO_UPLOAD_SIZE=209715200
# 单个 HTTP 请求体上限（字节，默认 512MB；在解析上传前即拒绝超大请求）
MAX_REQUEST_BODY_SIZE=536870912
# 公开批量导出：单次数量上限 / 限流窗口内最大次数 / 窗口秒数
PUBLIC_EXPORT_MAX_ITEMS=100
PUBLIC_EXPORT_RATE_MAX=10
PUBLIC_EXPORT_RATE_WINDOW=60
# 后台媒体预览签名令牌 / 加密分类解锁令牌有效期（分钟）
MEDIA_TOKEN_EXPIRE_MINUTES=30
FOLDER_TOKEN_EXPIRE_MINUTES=120
# 可信反向代理（逗号分隔 IP/CIDR）；仅当直连来源在此列表中时才采信 X-Forwarded-For
# 例：TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=
# 凭证上传限流：窗口内最大请求数 / 窗口秒数
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# 时区
TZ=Asia/Shanghai
